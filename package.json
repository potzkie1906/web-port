    "lint": "oxlint",
    "format": "prettier --write .",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
